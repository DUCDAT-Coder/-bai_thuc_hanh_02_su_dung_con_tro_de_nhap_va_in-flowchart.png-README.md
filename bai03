#include <stdio.h>
#include <stdlib.h>
typedef struct {
  char hoten[30];
  int ma;
  float d1, d2, d3;
}Data;
int main() {
  printf("Nhap so luong sinh vien: ");
  scanf("%d", &n);
  Data ds =(Data) malloc(n * sizeof(Data));
  if (ds == null)
    printf("Khong du bo nho\n");
    return 1;
  for (int i = 0; i < n; i++)
    prinf("\nNhap ma sv: ");
    scanf("%d", &ds[i].ma);
    prinf("\nNhap ho ten: ");
    scanf("%s", &ds[i].hoten);
    prinf("\nNhap diem 1, 2, 3: ");
    scanf("%f %f %f", &ds[i].d1, &ds[i].d2, &ds[i].d3);
  printf("\nDanh sach sinh vien\n");
  for (int i = 0; i < n; i++)
    printf("%s - %d - %.2f - %.2f - %.2f\n" ds[i].ma, ds[i].hoten, ds[i].d1, ds[i].d2, ds[i].d3);
  free(ds);
  return 0;
}
